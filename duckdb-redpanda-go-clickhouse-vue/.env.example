# Copy to .env and set CLICKHOUSE_PASSWORD. Compose reads .env automatically.

# --- Images (exact tags, never latest) ---------------------------------------
REDPANDA_IMAGE=redpandadata/redpanda:v26.1.18
CONSOLE_IMAGE=redpandadata/console:v3.11.0
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.3.40.16
PYTHON_IMAGE=python:3.13.15-slim
GO_IMAGE=golang:1.27.2
RUNTIME_IMAGE=alpine:3.23.6
NODE_IMAGE=node:22.23.2
PROMETHEUS_IMAGE=prom/prometheus:v3.13.4
GRAFANA_IMAGE=grafana/grafana:13.0.10

# --- Data ----------------------------------------------------------------------
DATA_DIR=../data
# Trading days to prep and replay, as ddmmyy separated by spaces.
# Full week (Linux box): DAYS="081121 091121 101121 111121 121121"
DAYS=081121
# Files that only feed the instruments table
INSTRUMENT_DAYS=141121

# --- Pipeline ------------------------------------------------------------------
PARTITIONS=32
PREP_THREADS=4
REPLAY_WORKERS=4
# CPU threads the replayer may use at once (GOMAXPROCS); empty = all the container has
REPLAY_THREADS=
# max, 1, 10 or 100 (multiple of real time)
REPLAY_SPEED=max
# Start at this time of the first day, HH:MM[:SS] Europe/Berlin; empty = first tick
REPLAY_FROM=
# Stop before this time of the first day, HH:MM[:SS] Europe/Berlin; empty = replay to the end
REPLAY_UNTIL=
# first_close, or zero (only for comparisons with zero-seeded references)
EMA_INIT=first_close
REDPANDA_SMP=1
REDPANDA_MEMORY=1G
CH_KAFKA_CONSUMERS=4
RETENTION_BYTES=20000000000

CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=change-me

# --- CPU pinning (compose.perf.yaml only), example for 16 threads --------------
CPUS_REDPANDA=0-3
CPUS_SIGNAL=4-7
CPUS_CLICKHOUSE=8-11
CPUS_REPLAYER=12-13
CPUS_GATEWAY=14-15
